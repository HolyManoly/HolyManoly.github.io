---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.png';

const name = 'Aleksandar Josic';
const role = 'Senior UX Engineer at Google';
const previously = ['Medivis', 'Rec Room', 'OxfordVR', 'Microsoft'];
const formspree = 'https://formspree.io/xayvqnaa';
const social = [
  {
    title: 'GitHub',
    url: 'https://github.com/HolyManoly',
    path: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z',
  },
  {
    title: 'LinkedIn',
    url: 'https://www.linkedin.com/in/aleksandarjosic/',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  },
];

const projects = (await getCollection('projects')).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
const work = projects.filter((p) => p.data.kind === 'work');
const lab = projects.filter((p) => p.data.kind === 'lab');
---

<Base title={name} description={`${name}, ${role}. A decade of XR engineering, now applied to UX.`}>
  <nav>
    <div class="container">
      <a class="brand" href="#top">{name}</a>
      <ul>
        <li><a href="#work">Work</a></li>
        <li><a href="#lab">Lab</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <header id="top">
    <div class="container">
      <Image src={profile} alt={name} width={256} height={256} class="profile" loading="eager" />
      <h1>{name}</h1>
      <p class="role">{role}</p>
      <hr />
      <p class="thesis">I design and build interfaces you can reach into: a decade of XR engineering, now applied to UX.</p>
      <p class="previously">Previously {previously.join(' · ')}</p>
    </div>
  </header>

  <section id="work">
    <div class="container">
      <h2>Selected work</h2>
      <ol class="features">
        {
          work.map((p) => (
            <li class="feature">
              <button type="button" class="media" data-open={p.id} aria-label={`Watch ${p.data.title} video`}>
                <Image src={p.data.image} alt="" widths={[560, 1120]} sizes="(min-width: 900px) 560px, 100vw" />
                <span class="play" aria-hidden="true" />
              </button>
              <div class="body">
                <h3>{p.data.title}</h3>
                <p class="period">{p.data.period}</p>
                <div set:html={p.rendered?.html} />
                <p class="actions">
                  <button type="button" data-open={p.id}>
                    Watch video
                  </button>
                  {p.data.link && <a href={p.data.link}>{p.data.linkName ?? p.data.link}</a>}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="lab">
    <div class="container">
      <h2>Lab</h2>
      <p class="intro">Game jams, hackathons, teaching and prototypes.</p>
      <ul class="grid">
        {
          lab.map((p) => (
            <li>
              <button type="button" class="card" data-open={p.id}>
                <Image src={p.data.image} alt="" widths={[360, 720]} sizes="(min-width: 768px) 360px, 100vw" />
                <span class="caption">{p.data.title}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <h2>About</h2>
      <p class="prose">
        Master's in Electrical and Computer Engineering, with an emphasis on game development and human-computer
        interaction. I spent a decade building XR: HoloLens apps at Microsoft, therapeutic VR at OxfordVR,
        cross-platform social play at Rec Room and spatial interaction for surgeons at Medivis. Today I'm a Senior UX
        Engineer at Google. I enjoy working on cross-functional teams, pushing the limits of what it means for people to
        interact with machines as well as each other.
      </p>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <h2>Contact Me</h2>
      <form class="prose" action={formspree} method="POST">
        <label>Name <input type="text" name="name" required autocomplete="name" /></label>
        <label>Email Address <input type="email" name="_replyto" required autocomplete="email" /></label>
        <label>Message <textarea name="message" rows="5" required></textarea></label>
        <input type="hidden" name="_subject" value="New submission!" />
        <input type="text" name="_gotcha" hidden />
        <button type="submit">Send</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container">
      <ul class="social">
        {
          social.map((s) => (
            <li>
              <a href={s.url} aria-label={s.title}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <p>Copyright &copy; {name} {new Date().getFullYear()}</p>
    </div>
  </footer>

  {
    projects.map((p) => (
      <dialog id={`project-${p.id}`}>
        <button type="button" class="close" aria-label="Close" data-close>
          &times;
        </button>
        <h2>{p.data.title}</h2>
        <div class="video">
          <iframe
            data-src={`https://www.youtube-nocookie.com/embed/${p.data.video}`}
            title={p.data.title}
            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
        {/* Work rows already show the text beside the thumbnail. */}
        {p.data.kind === 'lab' && <div class="prose" set:html={p.rendered?.html} />}
        <p class="meta">
          {p.data.link && <a href={p.data.link}>{p.data.linkName ?? p.data.link}</a>}
          <span>Date: {p.data.period}</span>
        </p>
      </dialog>
    ))
  }
</Base>

<script>
  // The iframe only gets its src while its dialog is open: keeps 15 YouTube
  // embeds off the initial load and stops playback on close.
  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
    if (!button) return;
    const dialog = document.getElementById(`project-${button.dataset.open}`) as HTMLDialogElement;
    const iframe = dialog.querySelector('iframe')!;
    iframe.src = iframe.dataset.src!;
    dialog.showModal();
  });

  for (const dialog of document.querySelectorAll('dialog')) {
    dialog.addEventListener('close', () => dialog.querySelector('iframe')!.removeAttribute('src'));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.close();
    });
  }
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--secondary);
    color: #fff;
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  nav .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  .brand {
    font-size: 1.25rem;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  header {
    background: var(--primary);
    color: #fff;
    text-align: center;
    padding: 4rem 0 5rem;
  }

  .profile {
    width: 256px;
    border-radius: 50%;
    margin: 0 auto 2rem;
  }

  header h1 {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
  }

  header hr {
    width: 15rem;
    max-width: 60%;
    margin: 1.5rem auto;
    border: 0;
    border-top: 4px solid #fff;
  }

  .role {
    font: 700 1.25rem Montserrat, system-ui, sans-serif;
    margin: 0.75rem 0 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .thesis {
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    max-width: 34ch;
    margin: 0 auto;
  }

  .previously {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .features {
    display: grid;
    gap: 4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 1.5rem 3rem;
    align-items: center;
  }

  .feature:nth-child(even) .media {
    order: 1;
  }

  .media {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: var(--secondary);
  }

  .media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .media:hover img,
  .media:focus-visible img {
    transform: scale(1.03);
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgb(38 37 38 / 0.8);
  }

  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    transform: translateX(3px);
    border-style: solid;
    border-width: 0.75rem 0 0.75rem 1.25rem;
    border-color: transparent transparent transparent #fff;
  }

  .feature h3 {
    font-size: 1.5rem;
  }

  .period {
    margin: 0.5rem 0 1rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary);
  }

  .feature .body :global(p) {
    margin: 0 0 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .actions button {
    font: 700 0.875rem Montserrat, system-ui, sans-serif;
    text-transform: uppercase;
    padding: 0.625rem 1.25rem;
    border: 2px solid var(--secondary);
    border-radius: 6px;
    background: none;
    color: var(--secondary);
    cursor: pointer;
  }

  .actions button:hover {
    background: var(--secondary);
    color: #fff;
  }

  .actions a {
    font-weight: 700;
    color: var(--secondary);
  }

  #lab {
    background: #f3f3f4;
  }

  .intro {
    text-align: center;
    margin: -1.5rem 0 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: var(--secondary);
  }

  .card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .caption {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(38 37 38 / 0.85);
    color: #fff;
    font: 700 1.125rem/1.3 Montserrat, system-ui, sans-serif;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .card:hover .caption,
  .card:focus-visible .caption {
    opacity: 1;
  }

  #about {
    background: var(--primary);
    color: #fff;
  }

  .prose {
    max-width: 640px;
    margin: 0 auto;
  }

  form {
    display: grid;
    gap: 1.25rem;
  }

  label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  input,
  textarea {
    font: inherit;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid #ccc;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--primary);
  }

  form button {
    justify-self: start;
    font: 700 1.125rem Montserrat, system-ui, sans-serif;
    padding: 0.75rem 2rem;
    border: 0;
    border-radius: 6px;
    background: var(--primary);
    color: #fff;
    cursor: pointer;
  }

  form button:hover {
    background: var(--secondary);
  }

  footer {
    background: var(--secondary);
    color: #fff;
    text-align: center;
    padding: 2.5rem 0;
  }

  .social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid #fff;
    border-radius: 50%;
  }

  .social a:hover {
    background: #fff;
  }

  .social svg {
    width: 1.25rem;
    fill: #fff;
  }

  .social a:hover svg {
    fill: var(--secondary);
  }

  footer p {
    margin: 0;
    font-size: 0.875rem;
  }

  dialog {
    width: min(900px, 100% - 2rem);
    max-height: calc(100% - 2rem);
    padding: 3rem 2rem 2rem;
    border: 0;
    border-radius: 8px;
    text-align: center;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  dialog h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .close {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    font-size: 2.5rem;
    line-height: 1;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--secondary);
  }

  .video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    margin-bottom: 1.5rem;
  }

  dialog .prose {
    text-align: left;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
  }

  .meta a {
    color: var(--accent);
    font-weight: 700;
  }
</style>
