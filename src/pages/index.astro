---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.png';

const name = 'Aleksandar Josic';
const tagline = 'AR/VR Development - Unity/C#';
const formspree = 'https://formspree.io/xayvqnaa';
const social = [
  {
    title: 'GitHub',
    url: 'https://github.com/HolyManoly',
    path: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z',
  },
  {
    title: 'LinkedIn',
    url: 'https://www.linkedin.com/in/aleksandarjosic/',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  },
];

const projects = (await getCollection('projects')).sort((a, b) =>
  b.data.start.localeCompare(a.data.start),
);
---

<Base title={name} description={`${name} Portfolio`}>
  <nav>
    <div class="container">
      <a class="brand" href="#top">{name}</a>
      <ul>
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <header id="top">
    <div class="container">
      <Image src={profile} alt={name} width={256} height={256} class="profile" loading="eager" />
      <h1>{name}</h1>
      <hr />
      <p class="tagline">{tagline}</p>
    </div>
  </header>

  <section id="portfolio">
    <div class="container">
      <h2>Portfolio</h2>
      <ul class="grid">
        {
          projects.map((p) => (
            <li>
              <button type="button" class="card" data-open={p.id}>
                <Image src={p.data.image} alt="" widths={[360, 720]} sizes="(min-width: 768px) 360px, 100vw" />
                <span class="caption">{p.data.title}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <h2>About</h2>
      <p class="prose">
        Masters in Electrical and Computer engineering, with emphasis on Game Development and Human-Computer interaction.
        12 years of Unity experience, 8 years of experience with immersive technologies. I enjoy working on
        cross-functional teams, pushing the limits of what it means for people to interact with machines as well as each
        other.
      </p>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <h2>Contact Me</h2>
      <form class="prose" action={formspree} method="POST">
        <label>Name <input type="text" name="name" required autocomplete="name" /></label>
        <label>Email Address <input type="email" name="_replyto" required autocomplete="email" /></label>
        <label>Message <textarea name="message" rows="5" required></textarea></label>
        <input type="hidden" name="_subject" value="New submission!" />
        <input type="text" name="_gotcha" hidden />
        <button type="submit">Send</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container">
      <ul class="social">
        {
          social.map((s) => (
            <li>
              <a href={s.url} aria-label={s.title}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <p>Copyright &copy; {name} {new Date().getFullYear()}</p>
    </div>
  </footer>

  {
    projects.map((p) => (
      <dialog id={`project-${p.id}`}>
        <button type="button" class="close" aria-label="Close" data-close>
          &times;
        </button>
        <h2>{p.data.title}</h2>
        <div class="video">
          <iframe
            data-src={`https://www.youtube-nocookie.com/embed/${p.data.video}`}
            title={p.data.title}
            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
        <div class="prose" set:html={p.rendered?.html} />
        <p class="meta">
          {p.data.link && <a href={p.data.link}>{p.data.linkName ?? p.data.link}</a>}
          <span>Date: {p.data.period}</span>
        </p>
      </dialog>
    ))
  }
</Base>

<script>
  // The iframe only gets its src while its dialog is open: keeps 15 YouTube
  // embeds off the initial load and stops playback on close.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-open]')) {
    const dialog = document.getElementById(`project-${button.dataset.open}`) as HTMLDialogElement;
    const iframe = dialog.querySelector('iframe')!;

    button.addEventListener('click', () => {
      iframe.src = iframe.dataset.src!;
      dialog.showModal();
    });
    dialog.addEventListener('close', () => iframe.removeAttribute('src'));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('[data-close]')) dialog.close();
    });
  }
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--secondary);
    color: #fff;
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  nav .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  .brand {
    font-size: 1.25rem;
  }

  nav ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  header {
    background: var(--primary);
    color: #fff;
    text-align: center;
    padding: 4rem 0 5rem;
  }

  .profile {
    width: 256px;
    border-radius: 50%;
    margin: 0 auto 2rem;
  }

  header h1 {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
  }

  header hr {
    width: 15rem;
    max-width: 60%;
    margin: 1.5rem auto;
    border: 0;
    border-top: 4px solid #fff;
  }

  .tagline {
    font-size: 1.5rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: var(--secondary);
  }

  .card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .caption {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgb(38 37 38 / 0.85);
    color: #fff;
    font: 700 1.125rem/1.3 Montserrat, system-ui, sans-serif;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .card:hover .caption,
  .card:focus-visible .caption {
    opacity: 1;
  }

  #about {
    background: var(--primary);
    color: #fff;
  }

  .prose {
    max-width: 640px;
    margin: 0 auto;
  }

  form {
    display: grid;
    gap: 1.25rem;
  }

  label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  input,
  textarea {
    font: inherit;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid #ccc;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--primary);
  }

  form button {
    justify-self: start;
    font: 700 1.125rem Montserrat, system-ui, sans-serif;
    padding: 0.75rem 2rem;
    border: 0;
    border-radius: 6px;
    background: var(--primary);
    color: #fff;
    cursor: pointer;
  }

  form button:hover {
    background: var(--secondary);
  }

  footer {
    background: var(--secondary);
    color: #fff;
    text-align: center;
    padding: 2.5rem 0;
  }

  .social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid #fff;
    border-radius: 50%;
  }

  .social a:hover {
    background: #fff;
  }

  .social svg {
    width: 1.25rem;
    fill: #fff;
  }

  .social a:hover svg {
    fill: var(--secondary);
  }

  footer p {
    margin: 0;
    font-size: 0.875rem;
  }

  dialog {
    width: min(900px, 100% - 2rem);
    max-height: calc(100% - 2rem);
    padding: 3rem 2rem 2rem;
    border: 0;
    border-radius: 8px;
    text-align: center;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  dialog h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .close {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    font-size: 2.5rem;
    line-height: 1;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--secondary);
  }

  .video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    margin-bottom: 1.5rem;
  }

  dialog .prose {
    text-align: left;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
  }

  .meta a {
    color: var(--accent);
    font-weight: 700;
  }
</style>
